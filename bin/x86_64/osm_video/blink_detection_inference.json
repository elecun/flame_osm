{
    "rt_cycle_ns": 1000000000,
    "verbose": 1,
    "info": {},
    "parameters": {
        "show_info": true,
        "visualize": true,
        "model_path": "bin/x86_64/models/blinklinmult-union.torchscript",
        "gpu_id": 0,
        "seq_len": 15,
        "crop_width": 64,
        "crop_height": 64,
        "threshold": 0.5,
        "eye_selection": "left",
        "input_port": "image_stream_1",
        "output_data_port": "blink_result",
        "output_monitor_port": "image_stream_1_processed_monitor"
    },
    "dataport": {
        "image_stream_1": {
            "transport": "ipc",
            "socket_type": "sub",
            "queue_size": 10
        },
        "blink_result": {
            "transport": "ipc",
            "socket_type": "pub",
            "queue_size": 10
        },
        "image_stream_1_processed_monitor": {
            "transport": "tcp",
            "host": "*",
            "port": 5204,
            "socket_type": "pub",
            "queue_size": 10,
            "resolution": {
                "width": 800,
                "height": 450
            }
        }
    }
}
