  <property name="styleSheet">
   <string notr="true">QMainWindow {
    background-color: #1e1e22;
    color: #e6e6e6;
}
QGroupBox {
    border: 1px solid #3c3c44;
    border-radius: 6px;
    margin-top: 10px;
    padding-top: 8px;
    font-weight: bold;
    color: #dcdce0;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 4px;
}
QLabel {
    color: #e6e6e6;
}
QLineEdit {
    background-color: #2b2b31;
    color: #ffffff;
    border: 1px solid #4a4a55;
    border-radius: 4px;
    padding: 6px 10px;
    font-size: 14px;
}
QPushButton {
    background-color: #3a3a44;
    color: #ffffff;
    border: 1px solid #555562;
    border-radius: 5px;
    padding: 8px 18px;
    font-size: 14px;
    font-weight: bold;
}
QPushButton:hover:!disabled {
    background-color: #505060;
    border-color: #7c7c92;
}
QPushButton:pressed:!disabled {
    background-color: #2e2e38;
}
QPushButton:disabled {
    background-color: #2a2a30;
    color: #777780;
    border-color: #3a3a42;
}
QPushButton#recordStartButton {
    background-color: #2e7d32;
    border-color: #43a047;
}
QPushButton#recordStartButton:hover:!disabled {
    background-color: #388e3c;
}
QPushButton#recordStartButton:disabled {
    background-color: #263829;
    color: #6b7d6e;
    border-color: #324435;
}
QPushButton#recordStopButton {
    background-color: #c62828;
    border-color: #e53935;
}
QPushButton#recordStopButton:hover:!disabled {
    background-color: #d32f2f;
}
QPushButton#recordStopButton:disabled {
    background-color: #3d2626;
    color: #806868;
    border-color: #4a3232;
}</string>
